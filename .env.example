# ServiceNow MCP Orchestrator Configuration

# Primary Instance (my-instance)
MY_INSTANCE_URL=
MY_INSTANCE_USERNAME=
MY_INSTANCE_PASSWORD=

# Another instance
ANOTHER_INSTANCE_URL=
ANOTHER_INSTANCE_USERNAME=
ANOTHER_INSTANCE_PASSWORD=

# Default instance for direct API calls (optional - falls back to SERVICENOW_* vars)
SERVICENOW_INSTANCE=my-instance
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_password_here

# Tool-specific settings (optional)
# Script Checker - Custom developers to track
CUSTOM_SCRIPT_USERS=john.doe,jane.smith

# Data Loader settings
DEFAULT_RECORD_COUNT=10

# UX Analyzer settings
HEADLESS=true
